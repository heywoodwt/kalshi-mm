# Copy to rust/.env (gitignored) and fill in real values.
# These are the only env vars kalshi-mm reads — see src/main.rs.

# "true" (or pass --paper) = simulated orders on real market data.
# Missing/invalid credentials below force paper mode regardless of this.
PAPER_MODE=true

KALSHI_API_KEY=your_kalshi_api_key_here
# Absolute path to the RSA private key PEM (or the PEM content itself).
KALSHI_API_SECRET=/absolute/path/to/your_key.pem
