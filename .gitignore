target/
*.log
# Machine-local build tuning (e.g. a target-dir override to dodge OneDrive
# file locks) — never portable, so it's per-checkout, not per-repo.
/.cargo/config.toml
# The lowvol production policies ARE committed (and baked into the release
# image); any OTHER checkpoints an operator drops into models/ stay ignored.
/models/*
!/models/realistic_20dim_*.onnx
.env
# Live Kalshi API private key(s) — KALSHI_API_SECRET points at one of these.
# NEVER commit. (The bot's key is shipped to the instance out-of-band.)
/mm_ppo_bot.txt
*.pem
# Real-money trade record fetched from the exchange (exchange-truth DATA,
# not code) — the RL retrain consumes these on the HPC. NEVER commit.
real_fills.jsonl
real_settlements.jsonl

.idea/
.DS_Store
